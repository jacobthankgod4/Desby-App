# ============================================================================
# Desby OS — Production Environment (EC2 Deployment)
# ============================================================================
# This .env is bundled into the Flutter web build.
# API calls go to the same origin (served by Nginx on the EC2).
#
# IMPORTANT: Before deploying, fill in your actual values below.
# Then copy this file to .env in the project root before building.
# ============================================================================

# App
APP_ENV=production
APP_NAME=Desby
APP_DEBUG=false

# API — same origin (Nginx proxies /api/* to Korra on localhost)
API_BASE_URL=/api
API_TIMEOUT_SECONDS=60

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Korra AI — direct to Korra (same EC2, proxied by Nginx)
KORRA_API_BASE_URL=/api/v2
KORRA_API_KEY=YOUR_KORRA_API_KEY
KORRA_PARTNER_KEY=YOUR_KORRA_PARTNER_KEY
KORRA_WEBHOOK_SECRET=

# Legacy alias
AI_SCAN_API_BASE_URL=/api/v2

# Payments
FLUTTERWAVE_PUBLIC_KEY=YOUR_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_ENCRYPTION_KEY=YOUR_FLUTTERWAVE_ENCRYPTION_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# Fez Logistics
FEZ_API_KEY=YOUR_FEZ_API_KEY
FEZ_API_URL=https://api.fezdelivery.com/v1

# Vimeo
VIMEO_ACCESS_TOKEN=YOUR_VIMEO_ACCESS_TOKEN

# Domain (for deep links, payment callbacks)
APP_DOMAIN=desby.app
APP_URL=https://desby.app
