{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "handle": [
        {
          "src": "/(.*)",
          "dest": "/build/web/$1"
        }
      ]
    },
    {
      "src": "/(.*)",
      "dest": "/build/web/index.html"
    }
  ]
}
