platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
ENV['DART_DEFINES'] = nil # Prevent CocoaPods parsing errors for malformed base64

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # 0. Copy GoogleService-Info.plist to Runner target Resources
  google_service_plist = File.join(__dir__, 'Runner', 'GoogleService-Info.plist')
  if File.exist?(google_service_plist)
    # Copy to Resources folder in build directory
    resources_dir = File.join(__dir__, 'Runner', 'Resources')
    FileUtils.mkdir_p(resources_dir) unless File.directory?(resources_dir)
    FileUtils.cp(google_service_plist, File.join(resources_dir, 'GoogleService-Info.plist'))
    puts "Copied GoogleService-Info.plist to Runner Resources"
  end

  # 1. Fix gRPC-Core C++ template syntax for Apple Clang 20+
  # This patches the source file to add missing template arguments
  gRPC_basic_seq = File.join(__dir__, 'Pods', 'gRPC-Core', 'src', 'core', 'lib', 'promise', 'detail', 'basic_seq.h')
  if File.exist?(gRPC_basic_seq)
    content = File.read(gRPC_basic_seq)
    # Fix: Traits::template CallSeqFactory(...) -> Traits::template CallSeqFactory<>(...)
    if content.include?('Traits::template CallSeqFactory(f_,') && !content.include?('Traits::template CallSeqFactory<>(')
      fixed_content = content.gsub('Traits::template CallSeqFactory(f_,', 'Traits::template CallSeqFactory<>(f_,')
      File.write(gRPC_basic_seq, fixed_content)
      puts "Patched gRPC-Core basic_seq.h for Apple Clang 20+ compatibility"
    end
  end

  # 1. Project level settings
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    ['OTHER_CFLAGS', 'GCC_PREPROCESSOR_DEFINITIONS'].each do |key|
      flags = config.build_settings[key]
      if flags.is_a?(String)
        # Use more aggressive scrubbing
        config.build_settings[key] = flags.gsub(/-GCC_WARN_INHIBIT_ALL_WARNINGS/, '-w').gsub(/\s-G\s/, ' ').strip
      end
    end
  end

  # 2. Fix for gRPC-Core C++ template compatibility with Apple Clang 20+
  # Add compiler flags to treat warnings as non-fatal errors for gRPC targets
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Get existing flags
      cxx_flags = config.build_settings['OTHER_CXXFLAGS'] || ''
      c_flags = config.build_settings['OTHER_CFLAGS'] || ''
      
      # Add flags to suppress/ignore specific errors
      # These flags: -w suppresses all warnings, then re-enable specific deprecation warnings as warnings
      unless cxx_flags.include?('-w')
        new_cxx_flags = "#{cxx_flags} -w"
        config.build_settings['OTHER_CXXFLAGS'] = new_cxx_flags
      end
      
      unless c_flags.include?('-w')
        new_c_flags = "#{c_flags} -w"  
        config.build_settings['OTHER_CFLAGS'] = new_c_flags
      end
    end
  end

  # 3. Target level settings
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
      
      # Remove unsupported -G and -GCC flags from all compiler/linker settings
      ['OTHER_CFLAGS', 'OTHER_LDFLAGS', 'OTHER_SWIFT_FLAGS', 'GCC_PREPROCESSOR_DEFINITIONS', 'CLANG_CXX_FLAGS', 'WARNING_CFLAGS'].each do |key|
        flags = config.build_settings[key]
        if flags.is_a?(String)
          config.build_settings[key] = flags.split(' ').reject { |f| f == '-G' || f.start_with?('-GCC') }.join(' ')
        elsif flags.is_a?(Array)
          config.build_settings[key].reject! { |f| f == '-G' || f.start_with?('-GCC') }
        end
      end
    end

    # DEEP SCRUB: Remove -G and -GCC from individual file compiler flags
    target.build_phases.each do |phase|
      next unless phase.is_a?(Xcodeproj::Project::Object::PBXSourcesBuildPhase)
      phase.files.each do |build_file|
        if build_file.settings && build_file.settings['COMPILER_FLAGS']
          flags = build_file.settings['COMPILER_FLAGS']
          if flags.include?('-G') || flags.include?('-GCC')
            build_file.settings['COMPILER_FLAGS'] = flags.split(' ').reject { |f| f == '-G' || f.start_with?('-GCC') }.join(' ')
          end
        end
      end
    end
  end
end
