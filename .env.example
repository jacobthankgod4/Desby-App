# Environment Configuration Template
# Copy this file to .env and fill in your values

# App Environment
APP_ENV=development
APP_DEBUG=true

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT_SECONDS=30
API_RETRY_ATTEMPTS=3

# Authentication
AUTH_TOKEN_REFRESH_THRESHOLD_MINUTES=5

# Firebase (Optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PERFORMANCE_MONITORING=false

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=false

# Storage
SECURE_STORAGE_ENABLED=true
CACHE_DURATION_HOURS=24

# EachLabs AI - Professional Virtual Try-On (IDM-VTON)
EACHLABS_API_KEY=
EACHLABS_BASE_URL=https://api.eachlabs.ai/v1/prediction

# Magic Hour API - AI Clothes Changer
MAGIC_HOUR_API_KEY=
MAGIC_HOUR_BASE_URL=https://api.magichour.ai

# ── Guided request journey (additive checkout) ──
# 1 = clients reach the guided "what do you want made" journey from a tailor
# profile or a design. 0 = fall back to the legacy booking chain.
# Both write to the same orders schema, so this is a pure rollback.
DESBY_REQUEST_JOURNEY=1

# ── Fez Logistics (delivery cost estimates at checkout) ──
# STATUS: NOT WORKING — waiting on Fez to issue account credentials.
#
# Fez needs TWO things: the `secret-key` header (we have it) AND an
# Authorization: Bearer token from /user/authenticate, which requires a
# per-account user_id + password. Verified against the sandbox 2026-10-10:
# secret-key alone -> 401 "Invalid session". Fez's own dashboard says those
# API credentials are shared only after KYC and internal review, so they do
# not exist yet. Delivery pricing and dispatch stay dormant until then.
#
# Until Fez provides USER_ID + PASSWORD, checkout shows "delivery unavailable"
# and order dispatch tells the team to arrange delivery manually. This is
# deliberate, not an error state to retry.
FEZ_LOGISTICS_SECRET_KEY=
FEZ_LOGISTICS_USER_ID=
FEZ_LOGISTICS_PASSWORD=
# Optional — defaults to https://apisandbox.fezdelivery.co/v1 when unset.
FEZ_LOGISTICS_BASE_URL=

# ── Terminal Shipping (T-Ship) — multi-carrier aggregator ──
# Replaces the Fez single-courier dependency. One integration reaches 42
# carriers (GIG, GIGM, DHL, Redstar, Dellyman, Chowdeck, Sendstack, Fez, …).
# Verified against the sandbox 2026-10-10.
#
# The secret key and the base URL travel together: a sandbox key with a live
# base URL would book real, paid shipments. Defaults to SANDBOX when unset.
#
# Verify with: bash scripts/verify_terminal_shipping.sh (read-only).
TERMINAL_API_SECRET_KEY=
TERMINAL_API_BASE_URL=https://sandbox.terminal.africa/v1
# Desby's pickup point — every order leaves from the same workshop.
# Phone must be +234… form; Terminal validates it against the address country.
LOGISTICS_PICKUP_NAME=Desby
LOGISTICS_PICKUP_PHONE=+2348000000000
LOGISTICS_PICKUP_ADDRESS=1 Allen Avenue
LOGISTICS_PICKUP_CITY=Ikeja
LOGISTICS_PICKUP_STATE=Lagos
LOGISTICS_PICKUP_ZIP=101123
LOGISTICS_FALLBACK_PHONE=+2348000000000
